<?xml version="1.0"?>
<!-- ROS 1（catkin）包描述。ROS 2 用 package.ros2.xml；build.sh 会按 ROS_DISTRO 把
     package.xml 指向对应那一个（与 src/ 下其它包同一套机制）。 -->
<package format="2">
    <name>imgo2_description</name>
    <version>2.0.0</version>
    <description>imgo2 robot description files</description>
    <maintainer email="qmq@gmail.com">qmq-h</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>catkin</buildtool_depend>
    <exec_depend>xacro</exec_depend>
    <exec_depend>joint_state_publisher</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
</package>
