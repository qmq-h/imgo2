        </visual>
        <collision>
            <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.063 0.013 0.0"/>
            <geometry>
                <cylinder length="0.041" radius="0.048"/>
            </geometry>
        </collision>
    </link>

    <joint name="LF_HAA" type="revolute">
        <origin xyz="0.1575 0.067 0.00025"/>
        <parent link="base"/>
        <child link="LF_hip"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.523" upper="0.523" effort="23.7" velocity="30.1"/>
    </joint>

    <link name="LF_thigh">
