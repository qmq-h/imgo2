<?xml version="1.0" encoding="utf-8"?>

<robot name="Imgo2">
    <mujoco>
        <compiler meshdir="$(find imgo2_description)/meshes/" balanceinertia="false" discardvisual="false" fusestatic="false"/>
    </mujoco>
    <link name="base">
        <inertial>
            <origin rpy="0 0 0" xyz="-0.00002223 -0.00136579 0.00287896"/>
            <mass value="5.53394020"/>
            <inertia ixx="0.03866860" ixy="0.00001502" ixz="0.00000229" 
                    iyy="0.10411461" iyz="-0.00009602" 
                    izz="0.12554111"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0.0"/>
            <geometry>
                <mesh filename="$(find imgo2_description)/meshes/base.STL"/>
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.315 0.243 0.147"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="0.136 0.07 -0.08325"/>
            <geometry>
                <box size="0.018 0.012 0.018"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="0.136 -0.07 -0.08325"/>
            <geometry>
                <box size="0.018 0.012 0.018"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="-0.136 0.07 -0.08325"/>
            <geometry>
                <box size="0.018 0.012 0.018"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="-0.136 -0.07 -0.08325"/>
            <geometry>
                <box size="0.018 0.012 0.018"/>
            </geometry>
        </collision>
    </link>
    <!-- LF LH RF RH -->
    <!-- 148.5 -->
    <!--!!!!!!!!!!!! Front Left Leg !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!-->
    <link name="LF_hip">
        <inertial>
            <origin xyz="0.05776150 0.01631658 0.00001927"/>
            <mass value="0.66982842"/>
            <inertia ixx="0.00047165" ixy="-0.00002152" ixz="-0.00000604" 
                    iyy="0.00094023" iyz="0.00000025" 
                    izz="0.00063679"/>
        </inertial>
        <visual>
            <geometry>
