<mujoco model="passive cart">
  <!-- Cart dimensions, masses and inertias mirror cart/cart.urdf. The rope is in the scene.
       2026-10-17 改版：车斗 0.6x0.45x0.02 m（底面离地 9 cm）、4 个 6 cm 直径小轮全部在车斗
       下方内侧、车斗正中固定 0.3 m 重物块（质量旋钮）。名义总重 0.8 + 4x0.05 + 2.0 = 3.0 kg。 -->
  <worldbody>
    <body name="cart_base" pos="-0.65 0 0.13">
      <freejoint name="cart_root"/>
      <inertial pos="0 0 0" mass="0.8" diaginertia="0.013526666666666666 0.024026666666666665 0.0375"/>
      <geom name="cart_deck" type="box" size="0.30 0.225 0.01" rgba="0.12 0.35 0.65 1"
            contype="3" conaffinity="3" friction="0.8 0.005 0.0001"/>
      <site name="tow_cart" pos="0.30 0 0" size="0.006" rgba="1 0.7 0 1"/>
      <body name="cart_ballast" pos="0 0 0.16">
        <inertial pos="0 0 0" mass="2.0" diaginertia="0.03 0.03 0.03"/>
        <geom name="cart_ballast_geom" type="box" size="0.15 0.15 0.15" rgba="0.45 0.45 0.48 1"
              contype="3" conaffinity="3" friction="0.8 0.005 0.0001"/>
      </body>
      <body name="cart_wheel_fl" pos="0.26 0.20 -0.07">
        <joint name="cart_wheel_fl_joint" type="hinge" axis="0 1 0" damping="0.0045"/>
        <inertial pos="0 0 0" mass="0.05" diaginertia="1.7916666666666667e-05 2.25e-05 1.7916666666666667e-05"/>
        <geom name="cart_wheel_fl_geom" type="cylinder" size="0.03 0.02" euler="1.5707963267948966 0 0"
              rgba="0.07 0.07 0.07 1" contype="3" conaffinity="3" friction="0.8 0.005 0.0001"/>
      </body>
      <body name="cart_wheel_fr" pos="0.26 -0.20 -0.07">
        <joint name="cart_wheel_fr_joint" type="hinge" axis="0 1 0" damping="0.0045"/>
        <inertial pos="0 0 0" mass="0.05" diaginertia="1.7916666666666667e-05 2.25e-05 1.7916666666666667e-05"/>
        <geom name="cart_wheel_fr_geom" type="cylinder" size="0.03 0.02" euler="1.5707963267948966 0 0"
              rgba="0.07 0.07 0.07 1" contype="3" conaffinity="3" friction="0.8 0.005 0.0001"/>
      </body>
      <body name="cart_wheel_rl" pos="-0.26 0.20 -0.07">
        <joint name="cart_wheel_rl_joint" type="hinge" axis="0 1 0" damping="0.0045"/>
        <inertial pos="0 0 0" mass="0.05" diaginertia="1.7916666666666667e-05 2.25e-05 1.7916666666666667e-05"/>
        <geom name="cart_wheel_rl_geom" type="cylinder" size="0.03 0.02" euler="1.5707963267948966 0 0"
              rgba="0.07 0.07 0.07 1" contype="3" conaffinity="3" friction="0.8 0.005 0.0001"/>
      </body>
      <body name="cart_wheel_rr" pos="-0.26 -0.20 -0.07">
        <joint name="cart_wheel_rr_joint" type="hinge" axis="0 1 0" damping="0.0045"/>
        <inertial pos="0 0 0" mass="0.05" diaginertia="1.7916666666666667e-05 2.25e-05 1.7916666666666667e-05"/>
        <geom name="cart_wheel_rr_geom" type="cylinder" size="0.03 0.02" euler="1.5707963267948966 0 0"
              rgba="0.07 0.07 0.07 1" contype="3" conaffinity="3" friction="0.8 0.005 0.0001"/>
      </body>
    </body>
  </worldbody>
</mujoco>
