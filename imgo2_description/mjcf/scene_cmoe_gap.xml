<mujoco model="imgo2 cmoe gap scene">
  <include file="imgo2.xml"/>

  <!-- CMoETrackGapTerrainCfg medium difficulty: four 0.12 m gaps separated
       by 0.80 m platforms. Shift training spawn_x=0.75 m to robot x=0. -->
  <statistic center="2 0 0.5" extent="5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <!-- top z=0, width=4 m, 1 m deep; group 5 is the terrain ray mask -->
    <geom name="platform_0" type="box" pos="0.15 0 -0.5" size="0.90 2.0 0.5" group="5" material="groundplane" friction="1 0.005 0.0001" contype="1" conaffinity="2"/>
    <geom name="platform_1" type="box" pos="1.57 0 -0.5" size="0.40 2.0 0.5" group="5" material="groundplane" friction="1 0.005 0.0001" contype="1" conaffinity="2"/>
    <geom name="platform_2" type="box" pos="2.49 0 -0.5" size="0.40 2.0 0.5" group="5" material="groundplane" friction="1 0.005 0.0001" contype="1" conaffinity="2"/>
    <geom name="platform_3" type="box" pos="3.41 0 -0.5" size="0.40 2.0 0.5" group="5" material="groundplane" friction="1 0.005 0.0001" contype="1" conaffinity="2"/>
    <geom name="platform_4" type="box" pos="5.59 0 -0.5" size="1.66 2.0 0.5" group="5" material="groundplane" friction="1 0.005 0.0001" contype="1" conaffinity="2"/>
  </worldbody>
</mujoco>
