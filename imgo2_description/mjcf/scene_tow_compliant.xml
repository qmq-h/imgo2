<mujoco model="imgo2 towing compliant">
  <include file="imgo2.xml"/>
  <include file="cart.xml"/>
  <statistic center="-0.3 0 0.5" extent="2.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.1" rgba="0.25 0.32 0.38 1"
          friction="0.8 0.005 0.0001" contype="1" conaffinity="2"/>
  </worldbody>
  <!-- A unilateral upper-length limit supplies tension only. MuJoCo's negative solref
       selects direct stiffness/damping units; compare transient force to Isaac Lab. -->
  <tendon>
    <spatial name="tow_rope" width="0.004" rgba="0.95 0.65 0.1 1" limited="true"
             range="0 0.8" solreflimit="-4000 -100" solimplimit="0.9 0.95 0.001">
      <site site="tow_robot"/>
      <site site="tow_cart"/>
    </spatial>
  </tendon>
</mujoco>
