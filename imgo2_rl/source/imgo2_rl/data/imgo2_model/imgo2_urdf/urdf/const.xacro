<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Constants for robot dimensions -->
    <xacro:property name="PI" value="3.1415926535897931"/>

    <!-- simplified collision value -->
    <xacro:property name="trunk_width" value="0.243"/>
    <xacro:property name="trunk_length" value="0.315"/>
    <xacro:property name="trunk_height" value="0.147"/>
    <xacro:property name="hip_radius" value="0.048"/>
    <xacro:property name="hip_length" value="0.041"/>
    <xacro:property name="thigh_shoulder_radius" value="0.048"/>
    <xacro:property name="thigh_shoulder_length" value="0.046"/>

    <xacro:property name="thigh_shoulder_y_offset" value="0.0235"/>

    <xacro:property name="thigh_width" value="0.06"/>
