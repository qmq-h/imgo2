{
    "configurations": [
        {
            "name": "Linux ROS 2 Humble",
            "compilerPath": "/usr/bin/c++",
            "intelliSenseMode": "linux-gcc-x64",
            "cppStandard": "gnu++17",
            "compileCommands": [
                "${workspaceFolder}/imgo2_deploy/build/robot_joint_controller/compile_commands.json"
            ],
            "includePath": [
