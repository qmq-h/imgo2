    "mlp_forward_code": "def forward(self,\n    x: Tensor) -> Tensor:\n  _0 = getattr(self, \"0\")\n  _1 = getattr(self, \"1\")\n  _2 = getattr(self, \"2\")\n  _3 = getattr(self, \"3\")\n  _4 = getattr(self, \"4\")\n  _5 = getattr(self, \"5\")\n  _6 = getattr(self, \"6\")\n  x0 = (_0).forward(x, )\n  x1 = (_1).forward(x0, )\n  x2 = (_2).forward(x1, )\n  x3 = (_3).forward(x2, )\n  x4 = (_4).forward(x3, )\n  x5 = (_5).forward(x4, )\n  return (_6).forward(x5, )\n",
